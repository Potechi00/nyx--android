#:import hex kivy.utils.get_color_from_hex

# ═══════════════════════════════════
# THEME COLORS
# ═══════════════════════════════════
# Dark BG:     (0.05, 0.05, 0.08, 1)   #0D0D14
# Surface:     (0.08, 0.08, 0.14, 1)   #141424
# Blue:        (0.29, 0.56, 0.85, 1)   #4A90D9
# Purple:      (0.4, 0.2, 0.8, 1)      #6633CC
# Green:       (0.2, 0.9, 0.4, 1)      #33E666

# ═══════════════════════════════════
# CUSTOM WIDGETS
# ═══════════════════════════════════

<CardBox@BoxLayout>:
    bg_color: (0.08, 0.08, 0.14, 1)
    canvas.before:
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]

<GlowButton@Button>:
    bg_color: (0.29, 0.56, 0.85, 1)
    background_normal: ''
    background_color: self.bg_color
    color: (1, 1, 1, 1)
    font_size: '13sp'
    canvas.before:
        Color:
            rgba: self.bg_color[:3] + [0.3]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10]

<OrbWidget@Widget>:
    pulse: 0
    canvas:
        Color:
            rgba: (0.29, 0.56, 0.85, 0.15)
        Ellipse:
            pos: self.center_x - 50, self.center_y - 50
            size: 100, 100
        Color:
            rgba: (0.29, 0.56, 0.85, 0.3)
        Ellipse:
            pos: self.center_x - 35, self.center_y - 35
            size: 70, 70
        Color:
            rgba: (0.29, 0.56, 0.85, 0.6)
        Ellipse:
            pos: self.center_x - 20, self.center_y - 20
            size: 40, 40

<TabButton@Button>:
    icon: ''
    label: ''
    active: False
    background_normal: ''
    background_color: (0,0,0,0)
    size_hint_x: 1
    BoxLayout:
        orientation: 'vertical'
        spacing: 2
        size_hint: 1, 1
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        Label:
            text: root.icon
            font_size: '22sp'
            color: (0.29, 0.56, 0.85, 1) if root.active else (0.4, 0.4, 0.5, 1)
            halign: 'center'
        Label:
            text: root.label
            font_size: '9sp'
            color: (0.29, 0.56, 0.85, 1) if root.active else (0.4, 0.4, 0.5, 1)
            halign: 'center'

# ═══════════════════════════════════
# SCREENS
# ═══════════════════════════════════

<HomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 8
        canvas.before:
            Color:
                rgba: (0.05, 0.05, 0.08, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        
        # Header
        BoxLayout:
            size_hint_y: 0.06
            Label:
                text: "🌑  N Y X"
                font_size: '26sp'
                bold: True
                color: (0.29, 0.56, 0.85, 1)
                halign: 'left'
        
        # Orb + Welcome
        BoxLayout:
            size_hint_y: 0.22
            orientation: 'vertical'
            
            OrbWidget:
                size_hint_y: 0.7
            
            Label:
                text: "Selamat pagi! ✨\nNYX siap membantu hari ini."
                size_hint_y: 0.3
                halign: 'center'
                font_size: '13sp'
                color: (0.6, 0.6, 0.8, 1)
        
        # Ringkasan Cards
        GridLayout:
            cols: 2
            spacing: 8
            size_hint_y: 0.22
            padding: [0, 5]
            
            CardBox:
                orientation: 'vertical'
                padding: 10
                Label:
                    text: "⏰"
                    font_size: '28sp'
                    halign: 'center'
                Label:
                    text: "Alarm: 2"
                    font_size: '14sp'
                    color: (0.8, 0.8, 1, 1)
                    halign: 'center'
            
            CardBox:
                orientation: 'vertical'
                padding: 10
                Label:
                    text: "📅"
                    font_size: '28sp'
                    halign: 'center'
                Label:
                    text: "Event: 1"
                    font_size: '14sp'
                    color: (0.8, 0.8, 1, 1)
                    halign: 'center'
            
            CardBox:
                orientation: 'vertical'
                padding: 10
                Label:
                    text: "🌤️"
                    font_size: '28sp'
                    halign: 'center'
                Label:
                    text: "Cuaca: 24°C"
                    font_size: '14sp'
                    color: (0.8, 0.8, 1, 1)
                    halign: 'center'
            
            CardBox:
                orientation: 'vertical'
                padding: 10
                Label:
                    text: "🔋"
                    font_size: '28sp'
                    halign: 'center'
                Label:
                    text: "Baterai: 82%"
                    font_size: '14sp'
                    color: (0.8, 0.8, 1, 1)
                    halign: 'center'
        
        # Quick Actions
        BoxLayout:
            size_hint_y: 0.1
            spacing: 8
            
            GlowButton:
                text: "⏰ Alarm"
                bg_color: (0.29, 0.56, 0.85, 1)
            GlowButton:
                text: "⏱️ Timer"
                bg_color: (0.4, 0.2, 0.8, 1)
            GlowButton:
                text: "📱 Apps"
                bg_color: (0.29, 0.56, 0.85, 1)
            GlowButton:
                text: "🎵 Musik"
                bg_color: (0.4, 0.2, 0.8, 1)
        
        Widget:
            size_hint_y: 0.05

<ChatScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        canvas.before:
            Color:
                rgba: (0.05, 0.05, 0.08, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        
        BoxLayout:
            size_hint_y: 0.07
            Label:
                text: "💬 Chat dengan NYX"
                font_size: '20sp'
                bold: True
                color: (0.29, 0.56, 0.85, 1)
        
        ScrollView:
            size_hint_y: 0.73
            GridLayout:
                id: chat_area
                cols: 1
                spacing: 8
                size_hint_y: None
                height: self.minimum_height
                padding: 5
        
        BoxLayout:
            size_hint_y: 0.1
            spacing: 5
            TextInput:
                id: chat_input
                hint_text: "Ketik pesan..."
                multiline: False
                background_color: (0.08, 0.08, 0.14, 1)
                foreground_color: (1, 1, 1, 1)
                hint_text_color: (0.4, 0.4, 0.5, 1)
            GlowButton:
                text: "Kirim"
                size_hint_x: 0.25
                on_press: root.send_message(chat_input.text)

<HistoryScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        canvas.before:
            Color:
                rgba: (0.05, 0.05, 0.08, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        
        BoxLayout:
            size_hint_y: 0.07
            Label:
                text: "📜 Riwayat Aktivitas"
                font_size: '20sp'
                bold: True
                color: (0.29, 0.56, 0.85, 1)
        
        ScrollView:
            GridLayout:
                id: history_list
                cols: 1
                spacing: 5
                size_hint_y: None
                height: self.minimum_height

<ActionScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        canvas.before:
            Color:
                rgba: (0.05, 0.05, 0.08, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        
        BoxLayout:
            size_hint_y: 0.07
            Label:
                text: "⚡ Aksi Cepat"
                font_size: '20sp'
                bold: True
                color: (0.29, 0.56, 0.85, 1)
        
        GridLayout:
            cols: 3
            spacing: 8
            size_hint_y: 0.8
            padding: 10
            
            GlowButton:
                text: "⏰ Alarm"
                bg_color: (0.29, 0.56, 0.85, 1)
            GlowButton:
                text: "⏱️ Timer"
                bg_color: (0.4, 0.2, 0.8, 1)
            GlowButton:
                text: "📱 Buka App"
                bg_color: (0.29, 0.56, 0.85, 1)
            GlowButton:
                text: "🎵 Musik"
                bg_color: (0.4, 0.2, 0.8, 1)
            GlowButton:
                text: "🔊 Volume"
                bg_color: (0.29, 0.56, 0.85, 1)
            GlowButton:
                text: "🔦 Senter"
                bg_color: (0.4, 0.2, 0.8, 1)
            GlowButton:
                text: "📶 Wi-Fi"
                bg_color: (0.29, 0.56, 0.85, 1)
            GlowButton:
                text: "🌤️ Cuaca"
                bg_color: (0.4, 0.2, 0.8, 1)
            GlowButton:
                text: "📝 Catatan"
                bg_color: (0.29, 0.56, 0.85, 1)

<SettingScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        canvas.before:
            Color:
                rgba: (0.05, 0.05, 0.08, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        
        BoxLayout:
            size_hint_y: 0.07
            Label:
                text: "⚙️ Pengaturan"
                font_size: '20sp'
                bold: True
                color: (0.29, 0.56, 0.85, 1)
        
        GridLayout:
            cols: 1
            spacing: 10
            size_hint_y: 0.8
            padding: 10
            
            CardBox:
                orientation: 'vertical'
                padding: 12
                Label:
                    text: "🌑 NYX v1.0.0"
                    color: (0.8, 0.8, 1, 1)
                    font_size: '15sp'
            
            CardBox:
                orientation: 'vertical'
                padding: 12
                Label:
                    text: "🌐 Bahasa: Indonesia"
                    color: (0.8, 0.8, 1, 1)
                    font_size: '15sp'
            
            CardBox:
                orientation: 'vertical'
                padding: 12
                Label:
                    text: "🔊 Mode Respons: Seimbang"
                    color: (0.8, 0.8, 1, 1)
                    font_size: '15sp'
            
            CardBox:
                orientation: 'vertical'
                padding: 12
                Label:
                    text: "🔐 Izin & Keamanan"
                    color: (0.8, 0.8, 1, 1)
                    font_size: '15sp'
            
            CardBox:
                orientation: 'vertical'
                padding: 12
                Label:
                    text: "ℹ️ Tentang NYX"
                    color: (0.8, 0.8, 1, 1)
                    font_size: '15sp'
