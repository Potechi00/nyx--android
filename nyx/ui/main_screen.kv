#:import hex kivy.utils.get_color_from_hex

# Warna theme
# #0D0D14 = (0.05, 0.05, 0.08, 1)
# #4A90D9 = (0.29, 0.56, 0.85, 1)
# #14141F = (0.08, 0.08, 0.12, 1)

<CustomTab@BoxLayout>:
    icon: ''
    label: ''
    selected: False
    size_hint_y: None
    height: 50
    
    BoxLayout:
        orientation: 'vertical'
        spacing: 2
        
        Label:
            text: root.icon
            font_size: '22sp'
            color: (0.29, 0.56, 0.85, 1) if root.selected else (0.5, 0.5, 0.5, 1)
        
        Label:
            text: root.label
            font_size: '10sp'
            color: (0.29, 0.56, 0.85, 1) if root.selected else (0.5, 0.5, 0.5, 1)

<HomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 10
        canvas.before:
            Color:
                rgba: (0.05, 0.05, 0.08, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        
        # Header
        BoxLayout:
            size_hint_y: 0.08
            Label:
                text: "🌑 NYX"
                font_size: '32sp'
                bold: True
                color: (0.29, 0.56, 0.85, 1)
                halign: 'left'
        
        # Welcome
        BoxLayout:
            size_hint_y: 0.1
            Label:
                text: "Selamat pagi! ✨\nNYX siap membantu."
                halign: 'center'
                font_size: '14sp'
                color: (0.7, 0.7, 0.9, 1)
        
        # Ringkasan
        GridLayout:
            cols: 2
            spacing: 8
            size_hint_y: 0.2
            padding: 5
            
            BoxLayout:
                canvas.before:
                    Color:
                        rgba: (0.08, 0.08, 0.12, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                Label:
                    text: "⏰ Alarm: 2"
                    font_size: '14sp'
                    color: (0.8, 0.8, 1, 1)
            
            BoxLayout:
                canvas.before:
                    Color:
                        rgba: (0.08, 0.08, 0.12, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                Label:
                    text: "📅 Event: 1"
                    font_size: '14sp'
                    color: (0.8, 0.8, 1, 1)
            
            BoxLayout:
                canvas.before:
                    Color:
                        rgba: (0.08, 0.08, 0.12, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                Label:
                    text: "🌤️ Cuaca: 24°C"
                    font_size: '14sp'
                    color: (0.8, 0.8, 1, 1)
            
            BoxLayout:
                canvas.before:
                    Color:
                        rgba: (0.08, 0.08, 0.12, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                Label:
                    text: "🔋 Baterai: 82%"
                    font_size: '14sp'
                    color: (0.8, 0.8, 1, 1)
        
        # Quick Actions
        GridLayout:
            cols: 4
            spacing: 8
            size_hint_y: 0.12
            
            Button:
                text: "⏰ Alarm"
                background_normal: ''
                background_color: (0.29, 0.56, 0.85, 1)
                color: (1, 1, 1, 1)
                font_size: '12sp'
            Button:
                text: "⏱️ Timer"
                background_normal: ''
                background_color: (0.29, 0.56, 0.85, 1)
                color: (1, 1, 1, 1)
                font_size: '12sp'
            Button:
                text: "📱 Apps"
                background_normal: ''
                background_color: (0.29, 0.56, 0.85, 1)
                color: (1, 1, 1, 1)
                font_size: '12sp'
            Button:
                text: "🎵 Musik"
                background_normal: ''
                background_color: (0.29, 0.56, 0.85, 1)
                color: (1, 1, 1, 1)
                font_size: '12sp'
        
        Widget:
            size_hint_y: 0.15

<ChatScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        canvas.before:
            Color:
                rgba: (0.05, 0.05, 0.08, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        
        BoxLayout:
            size_hint_y: 0.08
            Label:
                text: "💬 Chat dengan NYX"
                font_size: '20sp'
                bold: True
                color: (0.29, 0.56, 0.85, 1)
        
        ScrollView:
            size_hint_y: 0.72
            GridLayout:
                id: chat_area
                cols: 1
                spacing: 8
                size_hint_y: None
                height: self.minimum_height
                padding: 5
        
        BoxLayout:
            size_hint_y: 0.1
            spacing: 5
            TextInput:
                id: chat_input
                hint_text: "Ketik pesan..."
                multiline: False
                background_color: (0.08, 0.08, 0.12, 1)
                foreground_color: (1, 1, 1, 1)
            Button:
                text: "Kirim"
                size_hint_x: 0.2
                background_color: (0.29, 0.56, 0.85, 1)
                on_press: root.send_message(chat_input.text)

<HistoryScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        canvas.before:
            Color:
                rgba: (0.05, 0.05, 0.08, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        
        BoxLayout:
            size_hint_y: 0.08
            Label:
                text: "📜 Riwayat"
                font_size: '20sp'
                bold: True
                color: (0.29, 0.56, 0.85, 1)
        
        ScrollView:
            GridLayout:
                id: history_list
                cols: 1
                spacing: 5
                size_hint_y: None
                height: self.minimum_height

<ActionScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        canvas.before:
            Color:
                rgba: (0.05, 0.05, 0.08, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        
        BoxLayout:
            size_hint_y: 0.08
            Label:
                text: "⚡ Aksi Cepat"
                font_size: '20sp'
                bold: True
                color: (0.29, 0.56, 0.85, 1)
        
        GridLayout:
            cols: 3
            spacing: 8
            size_hint_y: 0.8
            padding: 10
            
            Button:
                text: "⏰ Alarm"
                background_color: (0.29, 0.56, 0.85, 1)
            Button:
                text: "⏱️ Timer"
                background_color: (0.29, 0.56, 0.85, 1)
            Button:
                text: "📱 Buka App"
                background_color: (0.29, 0.56, 0.85, 1)
            Button:
                text: "🎵 Musik"
                background_color: (0.29, 0.56, 0.85, 1)
            Button:
                text: "🔊 Volume"
                background_color: (0.29, 0.56, 0.85, 1)
            Button:
                text: "🔦 Senter"
                background_color: (0.29, 0.56, 0.85, 1)
            Button:
                text: "📶 Wi-Fi"
                background_color: (0.29, 0.56, 0.85, 1)
            Button:
                text: "🌤️ Cuaca"
                background_color: (0.29, 0.56, 0.85, 1)
            Button:
                text: "📝 Catatan"
                background_color: (0.29, 0.56, 0.85, 1)

<SettingScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        canvas.before:
            Color:
                rgba: (0.05, 0.05, 0.08, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        
        BoxLayout:
            size_hint_y: 0.08
            Label:
                text: "⚙️ Pengaturan"
                font_size: '20sp'
                bold: True
                color: (0.29, 0.56, 0.85, 1)
        
        GridLayout:
            cols: 1
            spacing: 8
            size_hint_y: 0.8
            padding: 10
            
            BoxLayout:
                canvas.before:
                    Color:
                        rgba: (0.08, 0.08, 0.12, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
                Label:
                    text: "🌑 NYX v1.0.0"
                    color: (0.8, 0.8, 1, 1)
            
            BoxLayout:
                canvas.before:
                    Color:
                        rgba: (0.08, 0.08, 0.12, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
                Label:
                    text: "🌐 Bahasa: Indonesia"
                    color: (0.8, 0.8, 1, 1)
            
            BoxLayout:
                canvas.before:
                    Color:
                        rgba: (0.08, 0.08, 0.12, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
                Label:
                    text: "🔐 Privasi & Izin"
                    color: (0.8, 0.8, 1, 1)
            
            BoxLayout:
                canvas.before:
                    Color:
                        rgba: (0.08, 0.08, 0.12, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
                Label:
                    text: "ℹ️ Tentang NYX"
                    color: (0.8, 0.8, 1, 1)
