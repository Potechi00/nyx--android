# ═══════════════════════════════════
# NYX UI v0.4 - ANIMATED & SMOOTH
# ═══════════════════════════════════

# ═══ CUSTOM WIDGETS ═══

<AnimatedCard@BoxLayout>:
    bg_color: (0.08, 0.08, 0.14, 1)
    opacity: 0
    canvas.before:
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14]
    on_parent:
        if self.opacity == 0: \
        self.opacity = 1

<RippleButton@Button>:
    bg_color: (0.29, 0.56, 0.85, 1)
    bg_pressed: (0.35, 0.65, 0.95, 1)
    background_normal: ''
    background_color: self.bg_color
    color: (1, 1, 1, 1)
    font_size: '13sp'
    font_bold: True
    canvas.before:
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]
    on_press: self.background_color = self.bg_pressed
    on_release: self.background_color = self.bg_color

<NeonCard@BoxLayout>:
    glow_color: (0.29, 0.56, 0.85, 1)
    bg_color: (0.08, 0.08, 0.14, 1)
    canvas.before:
        # Glow outer
        Color:
            rgba: self.glow_color[:3] + [0.08]
        RoundedRectangle:
            pos: self.pos[0]-1, self.pos[1]-1
            size: self.size[0]+2, self.size[1]+2
            radius: [16]
        # Main card
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14]

# ═══ HOME SCREEN ═══

<HomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 20
        spacing: 6
        canvas.before:
            Color:
                rgba: (0.04, 0.04, 0.06, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        
        # Header
        BoxLayout:
            size_hint_y: 0.06
            Label:
                text: "🌑  N Y X"
                font_size: '24sp'
                bold: True
                color: (0.35, 0.65, 0.95, 1)
                halign: 'left'
        
        # Orb Area
        RelativeLayout:
            size_hint_y: 0.22
            canvas:
                # Outer glow
                Color:
                    rgba: (0.29, 0.56, 0.85, 0.08)
                Ellipse:
                    pos: self.center_x - 55, self.center_y - 55
                    size: 110, 110
                # Middle ring
                Color:
                    rgba: (0.29, 0.56, 0.85, 0.2)
                Ellipse:
                    pos: self.center_x - 38, self.center_y - 38
                    size: 76, 76
                # Inner core
                Color:
                    rgba: (0.29, 0.56, 0.85, 0.4)
                Ellipse:
                    pos: self.center_x - 22, self.center_y - 22
                    size: 44, 44
                # Bright center
                Color:
                    rgba: (0.4, 0.7, 1, 0.7)
                Ellipse:
                    pos: self.center_x - 12, self.center_y - 12
                    size: 24, 24
            
            Label:
                text: "Selamat pagi! ✨\nNYX siap membantu."
                pos_hint: {'center_x': 0.5, 'y': 0}
                halign: 'center'
                font_size: '12sp'
                color: (0.5, 0.5, 0.7, 1)
        
        # Summary Cards
        GridLayout:
            cols: 2
            spacing: 8
            size_hint_y: 0.24
            padding: [0, 5]
            
            NeonCard:
                orientation: 'vertical'
                padding: 10
                glow_color: (0.29, 0.56, 0.85, 1)
                Label:
                    text: "⏰"
                    font_size: '26sp'
                    halign: 'center'
                Label:
                    text: "Alarm: 2"
                    font_size: '13sp'
                    color: (0.8, 0.8, 1, 1)
                    halign: 'center'
            
            NeonCard:
                orientation: 'vertical'
                padding: 10
                glow_color: (0.4, 0.2, 0.8, 1)
                Label:
                    text: "📅"
                    font_size: '26sp'
                    halign: 'center'
                Label:
                    text: "Event: 1"
                    font_size: '13sp'
                    color: (0.8, 0.8, 1, 1)
                    halign: 'center'
            
            NeonCard:
                orientation: 'vertical'
                padding: 10
                glow_color: (0.2, 0.8, 0.5, 1)
                Label:
                    text: "🌤️"
                    font_size: '26sp'
                    halign: 'center'
                Label:
                    text: "Cuaca: 24°C"
                    font_size: '13sp'
                    color: (0.8, 0.8, 1, 1)
                    halign: 'center'
            
            NeonCard:
                orientation: 'vertical'
                padding: 10
                glow_color: (0.8, 0.5, 0.2, 1)
                Label:
                    text: "🔋"
                    font_size: '26sp'
                    halign: 'center'
                Label:
                    text: "Baterai: 82%"
                    font_size: '13sp'
                    color: (0.8, 0.8, 1, 1)
                    halign: 'center'
        
        # Quick Actions
        BoxLayout:
            size_hint_y: 0.1
            spacing: 8
            
            RippleButton:
                text: "⏰ Alarm"
                bg_color: (0.29, 0.56, 0.85, 1)
            RippleButton:
                text: "⏱️ Timer"
                bg_color: (0.4, 0.2, 0.8, 1)
            RippleButton:
                text: "📱 Apps"
                bg_color: (0.29, 0.56, 0.85, 1)
            RippleButton:
                text: "🎵 Musik"
                bg_color: (0.4, 0.2, 0.8, 1)
        
        Widget:
            size_hint_y: 0.05

# ═══ CHAT SCREEN ═══

<ChatScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        canvas.before:
            Color:
                rgba: (0.04, 0.04, 0.06, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        
        BoxLayout:
            size_hint_y: 0.07
            Label:
                text: "💬 Chat NYX"
                font_size: '20sp'
                bold: True
                color: (0.35, 0.65, 0.95, 1)
        
        ScrollView:
            size_hint_y: 0.73
            effect_cls: 'ScrollEffect'
            GridLayout:
                id: chat_area
                cols: 1
                spacing: 8
                size_hint_y: None
                height: self.minimum_height
                padding: 5
        
        BoxLayout:
            size_hint_y: 0.1
            spacing: 5
            TextInput:
                id: chat_input
                hint_text: "Ketik pesan..."
                multiline: False
                background_color: (0.08, 0.08, 0.14, 1)
                foreground_color: (1, 1, 1, 1)
                hint_text_color: (0.4, 0.4, 0.5, 1)
                padding: [15, 10]
                font_size: '14sp'
            RippleButton:
                text: "Kirim"
                size_hint_x: 0.22
                bg_color: (0.29, 0.56, 0.85, 1)
                on_press: root.send_message(chat_input.text)

# ═══ HISTORY SCREEN ═══

<HistoryScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        canvas.before:
            Color:
                rgba: (0.04, 0.04, 0.06, 1)
            Rectangle:
                pos: self.pos
                size: self.size
        
        BoxLayout:
            size_hint_y: 0.07
            Label:
                text: "📜 Riwayat"
                font_size: '20sp'
                bold: True
                color: (0.35, 0.65, 0.95, 1)
        
        ScrollView:
            GridLayout:
                id: history_list
                cols: 1
                spacing: 5
                size_hint_y: None
                height: self.minimum_height

